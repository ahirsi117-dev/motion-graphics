[
  {
    "id": "l1",
    "text": "أقوى ليلتين بالأسبوع."
  },
  {
    "id": "l2",
    "text": "الثلاثاء: باريس ضد برشلونة، العاشرة مساءً بتوقيت الكويت."
  },
  {
    "id": "l3",
    "text": "الأربعاء: بايرن ضد آرسنال، العاشرة مساءً."
  },
  {
    "id": "l4",
    "text": "وليفربول وفياريال، وريال مدريد ولايبزيغ."
  },
  {
    "id": "l5",
    "text": "توقعك؟ اكتبه بالتعليقات."
  }
]