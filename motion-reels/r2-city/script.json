[
  {
    "id": "l1",
    "text": "سبع مباريات، وسبعة انتصارات."
  },
  {
    "id": "l2",
    "text": "سيتي واحد وعشرون نقطة، وآرسنال ثمانية عشر."
  },
  {
    "id": "l3",
    "text": "هالاند: ثماني أهداف."
  },
  {
    "id": "l4",
    "text": "بس هالاند متأثر بضربة، وسيمينيو يعرج."
  },
  {
    "id": "l5",
    "text": "منو يوقفهم؟"
  }
]